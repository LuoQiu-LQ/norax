---
import Layout from './Layout.astro'
import { formatDate, getReadingTime } from '../utils/format'

interface PostLink {
  id: string
  title: string
}

interface TocItem {
  depth: number
  slug: string
  text: string
}

interface Props {
  title: string
  postId: string
  date: string
  tags?: string[]
  description?: string
  body?: string
  newer?: PostLink | null
  older?: PostLink | null
  toc?: TocItem[]
}

const { title, postId, date, tags = [], description, body = '', newer = null, older = null, toc = [] } = Astro.props
const readingTime = getReadingTime(body)
const showToc = toc.length >= 2
---

<Layout title={`${title} - 墨白`} description={description}>
  {showToc && (
    <aside
      id="toc"
      aria-label="文章目录"
      class="hidden xl:flex flex-col fixed top-32 w-56 max-h-[70vh] overflow-y-auto pr-3"
      style="left: calc(50% - 24rem - 15rem);"
    >
      <div class="text-xs font-semibold uppercase tracking-widest text-ink-light/70 mb-3">目录</div>
      <ul class="space-y-1 text-sm border-l border-cream-dark">
        {toc.map(item => (
          <li>
            <a
              href={`#${item.slug}`}
              data-toc-link={item.slug}
              class:list={[
                'block py-1 -ml-px border-l-2 border-transparent text-ink-light hover:text-accent transition-colors',
                item.depth === 3 ? 'pl-7' : 'pl-4',
              ]}
            >{item.text}</a>
          </li>
        ))}
      </ul>
    </aside>
  )}

  <article class="max-w-3xl mx-auto px-6 py-12 md:py-16" data-post-id={postId}>
    <nav class="mb-12 opacity-0 animate-fade-in">
      <a 
        href="/"
        class="inline-flex items-center gap-2 text-sm text-ink-light hover:text-accent transition-colors group"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 transform group-hover:-translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        <span>返回首页</span>
      </a>
    </nav>
    
    <header class="mb-12 text-center">
      {tags.length > 0 && (
        <div class="flex justify-center gap-2 mb-6 opacity-0 animate-fade-in" style="animation-delay: 0.1s; animation-fill-mode: forwards;">
          {tags.map(tag => (
            <a 
              href={`/tags/${tag}`}
              class="text-xs font-medium text-accent bg-accent/10 px-3 py-1 rounded-full hover:bg-accent hover:text-white transition-colors"
            >
              {tag}
            </a>
          ))}
        </div>
      )}
      
      <h1 transition:name={`title-${postId}`} class="text-3xl md:text-4xl lg:text-5xl font-serif font-bold text-ink mb-6 leading-tight opacity-0 animate-fade-in" style="animation-delay: 0.2s; animation-fill-mode: forwards;">
        {title}
      </h1>
      
      <div class="flex items-center justify-center gap-6 text-sm text-ink-light opacity-0 animate-fade-in" style="animation-delay: 0.3s; animation-fill-mode: forwards;">
        <time datetime={date}>{formatDate(date)}</time>
        <span class="w-1 h-1 rounded-full bg-ink-light/50"></span>
        <span>约 {readingTime} 分钟阅读</span>
      </div>
      
      <div class="w-16 h-0.5 bg-accent mx-auto mt-8 opacity-0 animate-fade-in" style="animation-delay: 0.4s; animation-fill-mode: forwards;"></div>
    </header>
    
    <div class="prose prose-lg mx-auto opacity-0 animate-fade-in" style="animation-delay: 0.5s; animation-fill-mode: forwards;">
      <slot />
    </div>
    
    <footer class="mt-16 pt-8 border-t border-cream-dark">
      {tags.length > 0 && (
        <div class="mb-8">
          <div class="text-sm text-ink-light mb-3">标签</div>
          <div class="flex flex-wrap gap-2">
            {tags.map(tag => (
              <a 
                href={`/tags/${tag}`}
                class="text-sm text-ink-light bg-cream-dark px-3 py-1 rounded hover:bg-accent/20 hover:text-accent transition-colors"
              >
                #{tag}
              </a>
            ))}
          </div>
        </div>
      )}
      
      <div class="mb-8">
        <div class="text-sm text-ink-light mb-3">分享</div>
        <div class="flex gap-4">
          <button
            id="copy-link-btn"
            class="flex items-center gap-2 text-sm text-ink-light bg-cream-dark px-4 py-2 rounded hover:bg-accent/20 hover:text-accent transition-colors"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3" />
            </svg>
            <span>复制链接</span>
          </button>
        </div>
      </div>
      
      <a 
        href="/"
        class="inline-flex items-center gap-2 text-sm text-ink-light hover:text-accent transition-colors group"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 transform group-hover:-translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        <span>返回首页</span>
      </a>
    </footer>

    {(newer || older) && (
      <nav class="mt-12 grid grid-cols-1 md:grid-cols-2 gap-4" aria-label="文章导航">
        {older ? (
          <a href={`/posts/${older.id}`} class="group flex flex-col gap-1 p-5 rounded-xl border border-cream-dark hover:border-accent transition-colors">
            <span class="text-xs text-ink-light">← 上一篇</span>
            <span class="text-sm font-medium text-ink group-hover:text-accent transition-colors line-clamp-1">{older.title}</span>
          </a>
        ) : <span class="hidden md:block"></span>}
        {newer ? (
          <a href={`/posts/${newer.id}`} class="group flex flex-col gap-1 p-5 rounded-xl border border-cream-dark hover:border-accent transition-colors text-right md:items-end">
            <span class="text-xs text-ink-light">下一篇 →</span>
            <span class="text-sm font-medium text-ink group-hover:text-accent transition-colors line-clamp-1">{newer.title}</span>
          </a>
        ) : <span class="hidden md:block"></span>}
      </nav>
    )}

    <div class="mt-8 flex flex-col md:flex-row items-center justify-between gap-4 py-4 opacity-0 animate-fade-in" style="animation-delay: 0.6s; animation-fill-mode: forwards;">
      <div class="flex items-center gap-2 text-sm text-ink-light">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
        </svg>
        <span id="view-count">-- 次阅读</span>
      </div>

      <div class="flex items-center gap-4">
        <button id="btn-like" class="flex items-center gap-2 px-4 py-1.5 rounded-full border border-cream-dark hover:border-accent hover:text-accent transition-all text-sm text-ink-light group bg-white dark:bg-[#1a1a1a]">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 group-hover:scale-110 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 10h4.764a2 2 0 011.789 2.894l-3.5 7A2 2 0 0115.263 21h-4.017c-.163 0-.326-.02-.485-.06L7 20m7-10V5a2 2 0 00-2-2h-.095c-.5 0-.905.405-.905.905 0 .714-.211 1.412-.608 2.006L7 11v9m7-10h-2M7 20H5a2 2 0 01-2-2v-6a2 2 0 012-2h2.514" />
          </svg>
          <span id="like-count">赞 (0)</span>
        </button>

        <button id="btn-favorite" class="flex items-center gap-2 px-4 py-1.5 rounded-full border border-cream-dark hover:border-accent hover:text-accent transition-all text-sm text-ink-light group bg-white dark:bg-[#1a1a1a]">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 group-hover:scale-110 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z" />
          </svg>
          <span id="favorite-count">收藏 (0)</span>
        </button>
      </div>
    </div>

    <div class="mt-16 pt-8 border-t border-cream-dark">
      <h3 class="text-lg font-serif font-semibold text-ink mb-8">评论</h3>

      <div id="comments-list" class="space-y-6 mb-10">
        <p class="text-sm text-ink-light">加载评论中...</p>
      </div>

      <div class="bg-cream rounded-xl p-6 border border-cream-dark">
        <h4 class="text-sm font-medium text-ink mb-4">发表评论</h4>
        <div class="space-y-4">
          <input
            id="comment-author"
            type="text"
            placeholder="你的昵称"
            maxlength="50"
            class="w-full px-4 py-2 rounded-lg border border-cream-dark bg-white text-ink text-sm focus:outline-none focus:border-accent transition-colors"
          />
          <textarea
            id="comment-content"
            placeholder="写下你的想法... (最多500字)"
            maxlength="500"
            rows="4"
            class="w-full px-4 py-2 rounded-lg border border-cream-dark bg-white text-ink text-sm focus:outline-none focus:border-accent transition-colors resize-none"
          ></textarea>
          <div class="flex items-center justify-between">
            <span id="comment-msg" class="text-xs text-ink-light"></span>
            <button
              id="comment-submit"
              class="px-6 py-2 bg-accent text-white text-sm rounded-lg hover:bg-accent/80 transition-colors"
            >
              发表评论
            </button>
          </div>
        </div>
      </div>
    </div>
  </article>
</Layout>

<script is:inline data-astro-rerun>
(() => {
  const postId = document.querySelector('[data-post-id]')?.dataset.postId;
  if (!postId) return;
  const API = '/api';

  // 转义用户提供的内容，防止 XSS
  const escapeHtml = (str) => String(str ?? '').replace(/[&<>"']/g, (c) => ({
    '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
  }[c]));

  const toast = (msg) => (window.showToast ? window.showToast(msg) : alert(msg));

  // ── 复制链接（带反馈）──
  const copyLinkBtn = document.getElementById('copy-link-btn');
  copyLinkBtn?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(window.location.href);
      toast('链接已复制');
    } catch {
      toast('复制失败，请手动复制');
    }
  });

  // ── 代码块一键复制 ──
  document.querySelectorAll('.prose pre').forEach((pre) => {
    if (pre.querySelector('.code-copy-btn')) return;
    const btn = document.createElement('button');
    btn.className = 'code-copy-btn';
    btn.type = 'button';
    btn.setAttribute('aria-label', '复制代码');
    btn.textContent = '复制';
    btn.addEventListener('click', async () => {
      const code = pre.querySelector('code');
      try {
        await navigator.clipboard.writeText(code ? code.innerText : pre.innerText);
        btn.textContent = '已复制';
        setTimeout(() => { btn.textContent = '复制'; }, 1500);
      } catch {
        toast('复制失败');
      }
    });
    pre.appendChild(btn);
  });

  // ── 文章目录滚动高亮 (scroll-spy) ──
  const tocLinks = Array.from(document.querySelectorAll('[data-toc-link]'));
  if (tocLinks.length) {
    const linkMap = new Map(tocLinks.map(a => [a.dataset.tocLink, a]));
    const headings = tocLinks
      .map(a => document.getElementById(a.dataset.tocLink))
      .filter(Boolean);
    let current = null;
    const setActive = (slug) => {
      if (slug === current) return;
      current = slug;
      tocLinks.forEach(a => a.classList.toggle('toc-active', a.dataset.tocLink === slug));
    };
    const spy = new IntersectionObserver((entries) => {
      const visible = entries
        .filter(e => e.isIntersecting)
        .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
      if (visible.length) {
        setActive(visible[0].target.id);
      }
    }, { rootMargin: '-96px 0px -70% 0px', threshold: 0 });
    headings.forEach(h => spy.observe(h));
    // 点击目录项平滑滚动
    tocLinks.forEach(a => a.addEventListener('click', (e) => {
      const target = document.getElementById(a.dataset.tocLink);
      if (target) {
        e.preventDefault();
        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        history.replaceState(null, '', `#${a.dataset.tocLink}`);
        setActive(a.dataset.tocLink);
      }
    }));
  }

  // ── 初始化获取统计数据 (浏览、点赞、收藏) ──
  fetch(`${API}/views/${postId}`, { method: 'POST' })
    .then(r => r.json())
    .then(d => {
      document.getElementById('view-count').textContent = `${d.views} 次阅读`;
      document.getElementById('like-count').textContent = `赞 (${d.likes || 0})`;
      document.getElementById('favorite-count').textContent = `收藏 (${d.favorites || 0})`;
    })
    .catch(() => {
      document.getElementById('view-count').textContent = '统计暂不可用';
    });

  // ── 点赞逻辑防抖与处理 ──
  const btnLike = document.getElementById('btn-like');
  if (localStorage.getItem(`liked_${postId}`)) {
    btnLike.classList.add('text-accent', 'border-accent');
  }
  btnLike.addEventListener('click', () => {
    if (localStorage.getItem(`liked_${postId}`)) {
      alert('您已经点过赞啦！感谢支持！');
      return;
    }
    fetch(`${API}/likes/${postId}`, { method: 'POST' })
      .then(r => r.json())
      .then(d => {
        if (d.success) {
          document.getElementById('like-count').textContent = `赞 (${d.likes})`;
          btnLike.classList.add('text-accent', 'border-accent');
          localStorage.setItem(`liked_${postId}`, 'true');
        }
      })
      .catch(() => alert('网络异常，点赞失败，请稍后重试'));
  });

  // ── 收藏逻辑防抖与处理 ──
  const btnFav = document.getElementById('btn-favorite');
  if (localStorage.getItem(`fav_${postId}`)) {
    btnFav.classList.add('text-accent', 'border-accent');
  }
  btnFav.addEventListener('click', () => {
    if (localStorage.getItem(`fav_${postId}`)) {
      alert('这篇文章已经在您的收藏夹里啦！');
      return;
    }
    fetch(`${API}/favorites/${postId}`, { method: 'POST' })
      .then(r => r.json())
      .then(d => {
        if (d.success) {
          document.getElementById('favorite-count').textContent = `收藏 (${d.favorites})`;
          btnFav.classList.add('text-accent', 'border-accent');
          localStorage.setItem(`fav_${postId}`, 'true');
        }
      })
      .catch(() => alert('网络异常，收藏失败，请稍后重试'));
  });

  // ── 加载评论 ──
  const loadComments = () => {
    fetch(`${API}/comments/${postId}`)
      .then(r => r.json())
      .then(d => {
        const list = document.getElementById('comments-list');
        if (!d.comments || d.comments.length === 0) {
          list.innerHTML = '<p class="text-sm text-ink-light">还没有评论，来第一个吧！</p>';
          return;
        }
        list.innerHTML = d.comments.map(c => {
          const author = escapeHtml(c.author);
          const content = escapeHtml(c.content);
          const initial = escapeHtml(String(c.author ?? '?').charAt(0).toUpperCase());
          const time = escapeHtml(new Date(c.created_at).toLocaleString('zh-CN'));
          const id = Number(c.id);
          return `
          <div class="flex gap-4 group" id="comment-${id}">
            <div class="w-8 h-8 rounded-full bg-accent/20 flex items-center justify-center text-accent text-sm font-medium flex-shrink-0">
              ${initial}
            </div>
            <div class="flex-1">
              <div class="flex items-center gap-3 mb-1">
                <span class="text-sm font-medium text-ink">${author}</span>
                <span class="text-xs text-ink-light">${time}</span>
                <button
                  onclick="deleteComment(${id})"
                  class="text-xs text-red-400 hover:text-red-600 ml-auto opacity-0 group-hover:opacity-100 transition-opacity"
                  title="删除评论"
                >
                  删除
                </button>
              </div>
              <p class="text-sm text-ink-light leading-relaxed">${content}</p>
            </div>
          </div>
        `;
        }).join('');
      })
      .catch(() => {
        const list = document.getElementById('comments-list');
        if (list) list.innerHTML = '<p class="text-sm text-ink-light">评论加载失败，请稍后重试。</p>';
      });
  };
  loadComments();

  // ── 删除评论 (仅管理员通过 Token 操作才有效) ──
  window.deleteComment = (commentId) => {
    if (!confirm('确定要删除这条评论吗？')) return;

    fetch(`${API}/comments/${commentId}`, { method: 'DELETE' })
      .then(r => r.json())
      .then(d => {
        if (d.success) {
          const el = document.getElementById(`comment-${commentId}`);
          if (el) el.remove();
        } else {
          alert(d.error || '删除失败，可能需要管理员权限');
        }
      })
      .catch(() => alert('网络异常，删除失败，请稍后重试'));
  };

  // ── 发表评论 ──
  document.getElementById('comment-submit').addEventListener('click', () => {
    const author = document.getElementById('comment-author').value.trim();
    const content = document.getElementById('comment-content').value.trim();
    const msg = document.getElementById('comment-msg');

    if (!author) { msg.textContent = '请填写昵称'; return; }
    if (!content) { msg.textContent = '请填写评论内容'; return; }

    document.getElementById('comment-submit').disabled = true;
    msg.textContent = '提交中...';

    fetch(`${API}/comments/${postId}`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ author, content })
    })
      .then(r => r.json())
      .then(d => {
        if (d.success) {
          document.getElementById('comment-author').value = '';
          document.getElementById('comment-content').value = '';
          msg.textContent = '评论发表成功！';
          loadComments();
        } else {
          msg.textContent = d.error || '发表失败，请重试';
        }
      })
      .catch(() => { msg.textContent = '网络异常，发表失败，请稍后重试'; })
      .finally(() => {
        document.getElementById('comment-submit').disabled = false;
      });
  });
})();
</script>

<style is:global>
  .dark h1 {
    color: #e8e8e8;
  }
  .dark header h1 {
    color: #e8e8e8;
  }
  
  @keyframes fade-in {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  .animate-fade-in {
    animation: fade-in 0.6s cubic-bezier(0.4, 0, 0.2, 1) forwards;
  }
</style>